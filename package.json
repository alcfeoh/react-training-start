{
  "name": "react-training",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "bootstrap": "4.5.0",
    "lp-store-server": "^2.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --exclude src/jumbotron/Jumbotron.test.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "server": "node node_modules/lp-store-server",
    "cleanup": "git clean -fd && git reset --hard",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.0"
  }
}
